@PACKAGE_INIT@

# Re-find the PUBLIC dependencies: volumetric_kit_recon, whose camera tier
# calib's headers name, and through it volumetric_kit_core, whose Status and
# Result are in every signature. calib installs both beside itself, from one
# build, so recon's package re-finds the core calib was built against, at its
# minor version.
#
# TODO: find the core here too, ahead of recon, once the core's package can be
# found twice in one scope: a second include of its vkc_require_core.cmake
# redefines vkc_require_core, which then recurses.
include(CMakeFindDependencyMacro)
find_dependency(volumetric_kit_recon CONFIG)
# That minor may still be older than the core calib needs: then the package is
# not found, as a failed find_dependency leaves it.
vkc_require_core(@VC_CORE_MIN_VERSION@ PACKAGE volumetric_kit_calib)

# TODO: as the detect/solve tiers land, re-find their public deps here (OpenCV
# for detect, Ceres for solve).

include("${CMAKE_CURRENT_LIST_DIR}/volumetric_kit_calibTargets.cmake")

check_required_components(volumetric_kit_calib)
