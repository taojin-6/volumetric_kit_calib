@PACKAGE_INIT@

# Re-find the PUBLIC dependencies: volumetric_kit_core, whose Status and Result
# are in every signature, and volumetric_kit_recon, whose camera tier calib's
# headers name (and, with the capture tier, its sensor tier). calib installs
# both beside itself, which is the hint; CMAKE_PREFIX_PATH still takes
# precedence.
include(CMakeFindDependencyMacro)
# The core this build used, at its version: the core's version file then accepts
# only the same minor, no older -- so never a core whose package recursed when
# read twice (before 0.6.1), as recon's package config reads it again.
find_dependency(volumetric_kit_core @VC_CORE_VERSION@ CONFIG HINTS
                "${PACKAGE_PREFIX_DIR}")
if(@VC_WITH_RIG@)
  vkc_require_core(@VC_CORE_MIN_VERSION@ VULKAN PACKAGE volumetric_kit_calib)
else()
  vkc_require_core(@VC_CORE_MIN_VERSION@ PACKAGE volumetric_kit_calib)
endif()
# recon re-finds the core; one found elsewhere may bring another core, which
# its package config would then take in place of calib's. Then the package is
# not found, as a failed find_dependency leaves it.
set(_vc_core_dir "${volumetric_kit_core_DIR}")
find_dependency(volumetric_kit_recon CONFIG HINTS "${PACKAGE_PREFIX_DIR}")
if(NOT volumetric_kit_core_DIR STREQUAL _vc_core_dir)
  set(volumetric_kit_calib_FOUND FALSE)
  string(
    CONCAT volumetric_kit_calib_NOT_FOUND_MESSAGE
           "volumetric_kit_calib found volumetric_kit_core at ${_vc_core_dir}, "
           "but the volumetric_kit_recon at ${volumetric_kit_recon_DIR} "
           "brings another, at ${volumetric_kit_core_DIR}: put calib's "
           "prefix, ${PACKAGE_PREFIX_DIR}, first on CMAKE_PREFIX_PATH.")
  unset(_vc_core_dir)
  return()
endif()
unset(_vc_core_dir)

# OpenCV, when calib was built with it: calib_compute links its targets.
if(@VC_WITH_OPENCV@)
  find_dependency(OpenCV 5.0 CONFIG COMPONENTS core objdetect geometry)
endif()
# The capture tier's writer thread, when calib was built with it.
if(@VC_WITH_RIG@)
  find_dependency(Threads)
endif()
# TODO: re-find each later tier's public dependencies here as it lands.

include("${CMAKE_CURRENT_LIST_DIR}/volumetric_kit_calibTargets.cmake")

check_required_components(volumetric_kit_calib)
